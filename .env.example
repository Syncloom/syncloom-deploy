# Public host name (Caddy gets a Let's Encrypt certificate for it). Use "localhost" for a local trial.
SYNCLOOM_DOMAIN=sync.example.com
POSTGRES_PASSWORD=change-me

# Ports published on this host. Defaults: 80 and 443.
# For a non-standard port put it in the domain ("sync.example.com:7777") and set HTTPS_PORT to the same number.
# Let's Encrypt (HTTP-01) always needs port 80 of the domain to reach HTTP_PORT, e.g. through another proxy.
#SYNCLOOM_HTTP_PORT=80
#SYNCLOOM_HTTPS_PORT=443
# Image tag to pull from Docker Hub (default: the version this bundle was released with)
#SYNCLOOM_VERSION=0.1.1

# Blob storage: "fs" (the blobs volume) or "s3" (any S3-compatible store)
BLOB_BACKEND=fs
#S3_BUCKET=syncloom
#S3_REGION=us-east-1
#S3_ENDPOINT=https://s3.example.com
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# Optional OpenID Connect sign-in. Users must be created by an admin first unless auto-provisioning is on.
#OIDC_ISSUER=https://id.example.com/realms/main
#OIDC_CLIENT_ID=syncloom
#OIDC_CLIENT_SECRET=
#OIDC_AUTO_PROVISION=false
# Set to false to allow only OIDC (no built-in passwords)
#LOCAL_AUTH=true
